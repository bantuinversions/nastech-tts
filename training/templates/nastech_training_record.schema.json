{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nastech Expressive Speech Training Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audio_path",
    "transcript",
    "speaker_id",
    "consent_id",
    "emotion",
    "intensity",
    "behavior_events",
    "recording_quality",
    "split"
  ],
  "properties": {
    "audio_path": {
      "type": "string",
      "description": "Relative path to a licensed, consented mono WAV file."
    },
    "transcript": {
      "type": "string",
      "description": "ASCII English transcription of the recorded speech."
    },
    "speaker_id": {
      "type": "string",
      "description": "Stable pseudonymous speaker identifier."
    },
    "consent_id": {
      "type": "string",
      "description": "Reference to the signed consent and permitted use record."
    },
    "emotion": {
      "type": "string",
      "enum": [
        "angry",
        "sad",
        "happy",
        "excited",
        "fearful",
        "disgusted",
        "frustrated",
        "neutral",
        "calm"
      ]
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "behavior_events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "laugh",
          "chuckle",
          "sigh",
          "cough",
          "sniffle",
          "groan",
          "yawn",
          "gasp"
        ]
      },
      "uniqueItems": true
    },
    "recording_quality": {
      "type": "string",
      "enum": ["studio", "clean", "acceptable"]
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test"]
    }
  }
}
