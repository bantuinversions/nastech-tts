{
  "run_name": "nastech-voice-en-v1-behavior-lora",
  "base_model_id": "canopylabs/orpheus-3b-0.1-ft",
  "output_dir": "artifacts/nastech-voice-en-v1-behavior-lora",
  "dataset_manifest": "data/nastech_expressive_manifest.jsonl",
  "language": "en",
  "adapter": {
    "method": "qlora",
    "rank": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "training": {
    "epochs": 3,
    "learning_rate": 0.0001,
    "warmup_ratio": 0.05,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_sequence_length": 2048,
    "logging_steps": 10,
    "save_strategy": "epoch",
    "evaluation_strategy": "epoch",
    "seed": 42,
    "bf16": true,
    "gradient_checkpointing": true
  },
  "quality_gates": {
    "minimum_records": 300,
    "minimum_examples_per_direct_behavior": 50,
    "minimum_examples_per_emotion": 50,
    "required_splits": ["train", "validation", "test"],
    "require_documented_consent": true
  }
}
