        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentCompileRequest": {
        "properties": {
          "markup": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Markup"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "steps": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 12.0,
                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "markup"
        ],
        "title": "AgentCompileRequest",
        "description": "A structured NastechML request with local-runtime controls."
      },
      "AgentSpeechRequest": {
        "properties": {
          "markup": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Markup"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "steps": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 12.0,
                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "markup"
        ],
        "title": "AgentSpeechRequest",
        "description": "NastechML request that produces local Supertonic audio."
      },
      "AgentToolDescriptor": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "input_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input Schema"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "input_schema"
        ],
        "title": "AgentToolDescriptor"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OpenAISpeechRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "nastech-compact-en-v1"
          },
          "input": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Input"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "response_format": {
            "type": "string",
            "pattern": "^wav$",
            "title": "Response Format",
            "default": "wav"
          },
          "speed": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.7,
            "title": "Speed",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "input"
        ],
        "title": "OpenAISpeechRequest",
        "description": "Small OpenAI-compatible request shape for existing agent clients."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
