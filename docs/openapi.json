  "components": {
    "schemas": {
      "AgentCompileRequest": {
        "properties": {
          "markup": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Markup"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "steps": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 12.0,
                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps"
          },
          "provider_id": {
            "anyOf": [
