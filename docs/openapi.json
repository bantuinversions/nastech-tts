{
  "openapi": "3.1.0",
  "info": {
    "title": "Nastech Compact TTS",
    "description": "A local, CPU-tuned, agent-ready expressive TTS API backed by Supertonic 3 ONNX assets. Use /v1/agent/compile for an auditable behavior plan before synthesis.",
    "version": "0.5.0"
  },
